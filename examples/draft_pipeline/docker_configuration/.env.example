# Milvus Bulk Load Configuration
# Copy this file to .env and customize for your environment

# Storage Configuration
# Options: infinia, gcs, minio
STORAGE_TYPE=minio

# Storage endpoint (for Infinia and MinIO)
STORAGE_ENDPOINT=minio:9000

# Storage bucket name
STORAGE_BUCKET=milvus-bucket

# Storage credentials (for Infinia and MinIO)
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# SSL configuration (for Infinia)
USE_SSL=false

# Storage region (optional)
STORAGE_REGION=

# Root path in storage bucket
STORAGE_ROOT_PATH=bulk-load

# GCS-specific settings (if using GCS)
# USE_IAM=false
# GCS_CREDENTIALS_JSON=

# Docker volume directory
# Default: current directory
# DOCKER_VOLUME_DIRECTORY=/path/to/data

# Milvus Docker image
# Use GPU version: milvusdb/milvus:v2.5.4-gpu
# Use CPU version: milvusdb/milvus:v2.5.4
MILVUS_IMAGE=milvusdb/milvus:v2.5.4