# Google Cloud Storage Configuration for Milvus

# Storage Backend
STORAGE_TYPE=gcs

# GCS Configuration (using HMAC keys for S3-compatible access)
STORAGE_ENDPOINT=storage.googleapis.com
STORAGE_PORT=443
STORAGE_BUCKET=infinia-multimodal-milvus
STORAGE_ACCESS_KEY=GOOGYNYGAWJTSFKABDZYYVX4
STORAGE_SECRET_KEY=tfImR0PnI5rwoeH4K7TYUfN6K6BMZDqVPXiWorfO
USE_SSL=true
USE_IAM=false
STORAGE_ROOT_PATH=bulk-load

# Docker Configuration
DOCKER_VOLUME_DIRECTORY=./volumes

# Milvus Images - using v2.5.0 to match working setup
MILVUS_IMAGE_GPU=milvusdb/milvus:v2.5.0-gpu
MILVUS_IMAGE_CPU=milvusdb/milvus:v2.5.0

# Default mode (auto-detect GPU)
# Override with --gpu or --cpu flags
MILVUS_IMAGE=${MILVUS_IMAGE_GPU}