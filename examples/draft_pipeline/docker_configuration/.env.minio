# MinIO Storage Configuration for Milvus (Local Development)

# Storage Backend
STORAGE_TYPE=minio

# MinIO Configuration
STORAGE_ENDPOINT=minio:9000
STORAGE_BUCKET=milvus-bucket
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
USE_SSL=false
STORAGE_ROOT_PATH=bulk-load

# Docker Configuration
DOCKER_VOLUME_DIRECTORY=./volumes

# Milvus Images
MILVUS_IMAGE_GPU=milvusdb/milvus:v2.5.4-gpu
MILVUS_IMAGE_CPU=milvusdb/milvus:v2.5.4

# Default mode (auto-detect GPU)
# Override with --gpu or --cpu flags
MILVUS_IMAGE=${MILVUS_IMAGE_GPU}

MILVUS_LOG_LEVEL=warn  # Reduce logging overhead
MILVUS_DEPLOY_MODE=cluster
MILVUS_ENABLE_DYNAMIC_FIELD=false  # Disable if not needed
MILVUS_TTL_SECONDS=-1 